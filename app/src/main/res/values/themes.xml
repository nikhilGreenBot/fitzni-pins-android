<resources>
    <style name="Theme.FitzNiPins" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Starting theme: used by activity until Compose takes over.
         Sets the splash screen background to midnight navy to avoid white flash. -->
    <style name="Theme.FitzNiPins.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0A1628</item>
        <!-- The animated icon is set in res/drawable/ic_splash_icon -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">500</item>
        <item name="postSplashScreenTheme">@style/Theme.FitzNiPins</item>
    </style>
</resources>
